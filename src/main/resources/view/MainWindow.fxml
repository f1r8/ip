<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="athena.gui.MainWindow">
    <children>
        <VBox fx:id="windowLayout" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox fx:id="identityHeader" alignment="CENTER_LEFT" spacing="12.0"
                      minHeight="-Infinity" styleClass="identity-header">
                    <children>
                        <fx:include source="OwlAvatar.fxml" />
                        <VBox spacing="2.0" minWidth="0.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Athena" styleClass="identity-title" />
                                <Label text="Your task adviser" styleClass="identity-subtitle" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0"
                            vvalue="1.0" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="conversationContent">
                            <children>
                                <VBox fx:id="welcomePanel" spacing="9.0" styleClass="welcome-panel">
                                    <children>
                                        <Label text="Welcome, Your Majesty." wrapText="true"
                                               minHeight="-Infinity" maxWidth="Infinity"
                                               styleClass="welcome-heading" />
                                        <Label text="Let us put your tasks in order. Start here:" wrapText="true"
                                               minHeight="-Infinity" maxWidth="Infinity" />
                                        <Label fx:id="welcomeExamples" text="todo Read a book&#10;list"
                                               wrapText="true" minHeight="-Infinity" maxWidth="Infinity"
                                               styleClass="guide-example" />
                                        <Label text="Press Enter to send. Open Commands for more examples."
                                               wrapText="true" minHeight="-Infinity" maxWidth="Infinity"
                                               styleClass="welcome-hint" />
                                    </children>
                                </VBox>
                                <VBox fx:id="dialogContainer" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
                <!-- Keep the capped error panel and editor visible when the conversation is long. -->
                <VBox fx:id="composer" minHeight="-Infinity" spacing="9.0" styleClass="composer">
                    <children>
                        <HBox fx:id="composerHeader" alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label text="Enter to send" styleClass="composer-hint" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="commandsButton" onAction="#showCommands" text="_Commands"
                                        mnemonicParsing="true" accessibleText="Commands"
                                        accessibleHelp="Open a command reference without changing your draft."
                                        styleClass="commands-button" />
                            </children>
                        </HBox>
                        <ScrollPane fx:id="errorScroll" fitToWidth="true" hbarPolicy="NEVER"
                                    minHeight="0.0" maxHeight="320.0" visible="false" managed="false"
                                    styleClass="error-scroll">
                            <content>
                                <VBox fx:id="errorPanel" visible="false" managed="false" spacing="7.0"
                                      styleClass="error-panel" accessibleText="Command needs attention">
                                    <children>
                                        <Label fx:id="errorHeading" text="Command needs attention"
                                               wrapText="true" minHeight="-Infinity" maxWidth="Infinity"
                                               styleClass="error-heading" />
                                        <Label fx:id="errorExplanation" wrapText="true" minHeight="-Infinity"
                                               maxWidth="Infinity" styleClass="error-explanation" />
                                        <Label fx:id="errorHint" wrapText="true" minHeight="-Infinity"
                                               maxWidth="Infinity" styleClass="error-hint" />
                                        <Label text="Example" wrapText="true"
                                               minHeight="-Infinity" styleClass="example-heading" />
                                        <Label fx:id="errorExample" wrapText="true" minHeight="-Infinity"
                                               maxWidth="Infinity" styleClass="error-example" />
                                        <Button fx:id="useExampleButton" onAction="#useExample"
                                                mnemonicParsing="false" text="Use example"
                                                wrapText="true" minHeight="-Infinity" maxWidth="Infinity"
                                                styleClass="example-button" />
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                        <Label fx:id="inputStatus" visible="false" managed="false" wrapText="true"
                               minHeight="-Infinity" maxWidth="Infinity" styleClass="input-status" />
                        <HBox fx:id="commandInputRow" alignment="CENTER" spacing="8.0">
                            <children>
                                <TextField fx:id="userInput" onAction="#handleUserInput" minWidth="0.0"
                                           prefHeight="41.0" promptText="Enter a command..."
                                           accessibleText="Your command" HBox.hgrow="ALWAYS" />
                                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                                        prefHeight="41.0" minWidth="-Infinity" text="Send" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
